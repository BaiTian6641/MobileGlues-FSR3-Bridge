    @ModifyArgs(method = "<init>", at = @At(value = "INVOKE",
            target = "@TARGET_CONSTRUCTOR@"), require = 1)
    private void mgfsr3$allocate(Args args, ProgramSet programSet) {
        Fsr3Bridge.setPackHasFinalPass(AdapterProfile.hasFinalPass(programSet));
        Fsr3Bridge.invalidateCamera();
        int width = Fsr3Bridge.sceneWidth(args.<Integer>get(0));
        int height = Fsr3Bridge.sceneHeight(args.<Integer>get(1));
        int depth = Fsr3Bridge.sceneDepthTexture(args.<Integer>get(2), width, height);
        args.set(0, width);
        args.set(1, height);
        args.set(2, depth);
    }

    @ModifyArgs(method = "beginLevelRendering()V", at = @At(value = "INVOKE",
            target = "@TARGET_RESIZE@"), require = 1)
    private void mgfsr3$resize(Args args) {
        // One handler sees the current dimensions before replacing any argument.
        int width = Fsr3Bridge.sceneWidth(args.<Integer>get(2));
        int height = Fsr3Bridge.sceneHeight(args.<Integer>get(3));
        int depth = Fsr3Bridge.sceneDepthTexture(args.<Integer>get(1), width, height);
        args.set(1, depth);
        args.set(2, width);
        args.set(3, height);
    }
