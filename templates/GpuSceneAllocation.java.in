    @Unique private SceneDepthGeneration mgfsr3$depthGeneration;

    @Unique
    private int mgfsr3$depthVersion(int sourceVersion, Object selectedDepth) {
        if (mgfsr3$depthGeneration == null) mgfsr3$depthGeneration = new SceneDepthGeneration();
        return mgfsr3$depthGeneration.prepare(sourceVersion, selectedDepth);
    }

    @ModifyArgs(method = "<init>", at = @At(value = "INVOKE",
            target = "@TARGET_CONSTRUCTOR@"), require = 1)
    private void mgfsr3$allocate(Args args, ProgramSet programSet) {
        Fsr3Bridge.setPackHasFinalPass(AdapterProfile.hasFinalPass(programSet));
        Fsr3Bridge.invalidateCamera();
        int width = Fsr3Bridge.sceneWidth(args.<Integer>get(0));
        int height = Fsr3Bridge.sceneHeight(args.<Integer>get(1));
        Object depth = Fsr3Bridge.sceneDepthObject(args.get(2), width, height);
        args.set(0, width);
        args.set(1, height);
        args.set(2, depth);
        args.set(3, mgfsr3$depthVersion(args.<Integer>get(3), depth));
    }

    @ModifyArgs(method = "beginLevelRendering()V", at = @At(value = "INVOKE",
            target = "@TARGET_RESIZE@"), require = 1)
    private void mgfsr3$resize(Args args) {
        // 26.2's second argument is GpuTexture; integer ordinals no longer identify dimensions.
        int width = Fsr3Bridge.sceneWidth(args.<Integer>get(2));
        int height = Fsr3Bridge.sceneHeight(args.<Integer>get(3));
        Object depth = Fsr3Bridge.sceneDepthObject(args.get(1), width, height);
        args.set(0, mgfsr3$depthVersion(args.<Integer>get(0), depth));
        args.set(1, depth);
        args.set(2, width);
        args.set(3, height);
    }

    @Inject(method = "<init>", at = @At("RETURN"), require = 1)
    private void mgfsr3$depthAllocated(CallbackInfo callback) {
        mgfsr3$depthGeneration.complete();
        Fsr3Bridge.completeSceneDepthUpdate();
    }

    @Inject(method = "beginLevelRendering()V", at = @At(value = "INVOKE",
            target = "@TARGET_RESIZE@", shift = At.Shift.AFTER), require = 1)
    private void mgfsr3$depthResized(CallbackInfo callback) {
        // Iris' return value describes extent changes, not texture changes.
        mgfsr3$depthGeneration.complete();
        Fsr3Bridge.completeSceneDepthUpdate();
    }
